{
  "name": "@quiteer/electron-browser",
  "type": "module",
  "version": "0.0.1",
  "description": "基于electron , 提供浏览器窗口创建与窗口仓库管理",
  "author": "quiteer",
  "license": "MIT",
  "homepage": "https://github.com/QuiteerJs/electron-modules/tree/main/packages/browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuiteerJs/electron-modules.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/QuiteerJs/electron-modules/issues"
  },
  "keywords": [
    "electron",
    "browser-window",
    "window"
