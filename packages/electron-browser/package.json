{
  "name": "@quiteer/electron-browser",
  "version": "0.0.1",
  "description": "基于electron , 提供浏览器窗口创建与窗口仓库管理",
  "author": "quiteer",
  "license": "MIT",
  "keywords": [
    "electron"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "update-version": "bumpp package.json"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
