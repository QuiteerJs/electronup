{
  "name": "@quiteer/electron-browser",
  "type": "module",
  "version": "0.0.1",
  "description": "基于electron , 提供浏览器窗口创建与窗口仓库管理",
  "author": "quiteer",
  "license": "MIT",
  "keywords": [
    "electron"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "update-version": "bumpp package.json"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  }
}
