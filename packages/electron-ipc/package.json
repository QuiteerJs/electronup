{
  "name": "@quiteer/electron-ipc",
  "type": "module",
  "version": "3.0.0",
  "description": "基于electron , 提供了一些 独立无副作用的 ipc 事件相关操作",
  "author": "quiteer",
  "license": "MIT",
  "homepage": "https://github.com/QuiteerJs/electron-modules/tree/main/packages/ipc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuiteerJs/electron-modules.git",
    "directory": "packages/ipc"
  },
  "bugs": {
    "url": "https://github.com/QuiteerJs/electron-modules/issues"
  },
  "keywords": [
    "electron",
    "ipc"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./web/index.d.ts",
      "import": "./web/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "web"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "update-version": "bumpp package.json"
  }
