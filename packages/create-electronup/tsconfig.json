{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2023"
    ],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "declaration": false,
    "outDir": "dist",
    "sourceMap": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "build.config.ts",
    "src"
  ]
}
