{
  "name": "@quiteer/electron-preload",
  "version": "3.0.0",
  "description": "基于electron , 提供 sandbox 可用的预加载脚本, 暴露带通道白名单的 $ipc 与收敛的 $webFrame / $clipboard",
  "keywords": [
    "electron",
    "preload"
  ],
  "homepage": "https://github.com/QuiteerJs/electronup/tree/main/packages/electron-preload#readme",
  "bugs": {
    "url": "https://github.com/QuiteerJs/electronup/issues"
  },
  "license": "MIT",
  "author": "quiteer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuiteerJs/electronup.git",
    "directory": "packages/electron-preload"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "index.cjs",
    "index.d.cts"
  ],
  "type": "module",
  "main": "index.cjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./main": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vp pack && node --test test/.out/preload.test.js test/.out/main.test.js",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit",
    "prepublishOnly": "node ../../.github/scripts/check-publish-ready.mjs && pnpm run build"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "electron": ">=44"
  },
  "engines": {
    "node": ">=20"
  }
}
