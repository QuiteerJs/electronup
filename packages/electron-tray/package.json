{
  "name": "@quiteer/electron-tray",
  "type": "module",
  "version": "0.0.1",
  "description": "基于electron , 提供系统托盘创建与托盘实例统一管理",
  "author": "quiteer",
  "license": "MIT",
  "keywords": [
    "electron",
    "tray"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "tsdown -c test/tsdown.config.ts && node --test test/.out/tray.test.js",
    "update-version": "bumpp package.json"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  }
}
