{
  "name": "@quiteer/electron-tray",
  "version": "0.0.1",
  "description": "基于electron , 提供系统托盘创建与托盘实例统一管理",
  "keywords": [
    "electron",
    "tray"
  ],
  "homepage": "https://github.com/QuiteerJs/electronup/tree/main/packages/electron-tray#readme",
  "bugs": {
    "url": "https://github.com/QuiteerJs/electronup/issues"
  },
  "license": "MIT",
  "author": "quiteer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuiteerJs/electronup.git",
    "directory": "packages/electron-tray"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vp pack && node --test test/.out/tray.test.js",
    "prepublishOnly": "node ../../.github/scripts/check-publish-ready.mjs && pnpm run build"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "electron": ">=30"
  },
  "engines": {
    "node": ">=20"
  }
}
