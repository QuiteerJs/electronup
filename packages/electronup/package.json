{
  "name": "electronup",
  "version": "0.3.1",
  "description": "融合构建 electron 应用需要的构建工具,保留原有配置习惯的命令行工具 ",
  "author": "quiteer",
  "license": "MIT",
  "homepage": "https://github.com/QuiteerJs/electronup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuiteerJs/electronup.git"
  },
  "bugs": {
    "url": "https://github.com/QuiteerJs/electronup/issues"
  },
  "keywords": [
    "vite",
    "vite-plus",
    "electron-builder",
    "electron"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/client/index.d.mts",
        "import": "./dist/client/index.mjs",
        "require": "./dist/client/index.mjs"
      }
    },
    "bin": {
      "electronup": "./dist/bin/electronup.mjs"
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/client/index.d.mts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.mjs"
    }
  },
  "main": "./dist/client/index.mjs",
  "module": "./dist/client/index.mjs",
  "types": "./dist/client/index.d.mts",
  "bin": {
    "electronup": "./src/dev.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "test": "vp test run",
    "prepublishOnly": "node ../../.github/scripts/check-publish-ready.mjs && pnpm run build"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@types/node": ">= 22",
    "electron": ">= 28",
    "vue": ">= 3"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@quiteer/parser-config": "^1.0.3",
    "cac": "^7.1.0",
    "dotenv": "^17.4.2",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.4.1",
    "picocolors": "^1.1.1",
    "portfinder": "^1.0.38",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "^40.10.6",
    "vitest": "catalog:"
  }
}
