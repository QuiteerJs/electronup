{
  "name": "electronup-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "description": "融合构建 electron 应用需要的构建工具,保留原有配置习惯的命令行工具 ",
  "author": "quiteer",
  "license": "MIT",
  "homepage": "https://github.com/QuiteerJs/electronup#readme",
  "scripts": {
    "work:dev": "pnpm --filter './packages/*' dev",
    "work:build": "pnpm --filter './packages/*' build",
    "modules:build": "pnpm --filter \"./packages/electron-*\" build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "template:run": "pnpm --filter './template/*' dev",
    "lint": "vp lint . --ignore-pattern \"**/.vitepress/cache/**\"",
    "lint:fix": "vp lint . --fix --ignore-pattern \"**/.vitepress/cache/**\"",
    "typecheck": "tsc -p packages/electronup/tsconfig.json --noEmit && tsc -p packages/create-electronup/tsconfig.json --noEmit && pnpm --filter \"./packages/electron-*\" typecheck",
    "test": "pnpm --filter \"./packages/*\" test",
    "test:e2e:modules": "pnpm --filter ./playground/modules-smoke test:e2e",
    "prepare": "simple-git-hooks",
    "upgrade:latest": "pnpm update --latest",
    "upgrade:interactive": "pnpm update --interactive --latest",
    "commit": "qui gc",
    "version:core": "bumpp packages/electronup/package.json --no-commit --no-tag --no-push",
    "version:scaffold": "bumpp packages/create-electronup/package.json --no-commit --no-tag --no-push",
    "changeset": "changeset",
    "version:modules": "changeset version",
    "changelog": "qui cl"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@quiteer/scripts": "^0.1.6",
    "@quiteer/ts-config": "^0.0.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.9",
    "bumpp": "10.3.1",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vite-plus": "catalog:",
    "vitepress": "2.0.0-alpha.20"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm qui gv",
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,vue}": "vp lint --fix"
  }
}
